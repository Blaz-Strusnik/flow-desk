# Copy this file to `.env` at the repo root before running
# `docker compose -f docker-compose.prod.yml up -d --build` — Docker Compose
# reads a root `.env` automatically to fill in the ${VARS} below.

# --- Postgres ---
POSTGRES_USER=flowdesk
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=flowdesk

# --- API (apps/api) ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-value
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-value
# Your public site origin(s) — the frontend is only allowed to call the API
# from here. No trailing slash.
CORS_ORIGIN=https://your-domain.com

# --- Web (apps/web) ---
# Baked into the client bundle at BUILD time (see README: "Changing these
# later requires a rebuild"). Must be the public HTTPS URL your browser can
# reach — not the Docker-internal service name.
NEXT_PUBLIC_API_URL=https://api.your-domain.com
NEXT_PUBLIC_WS_URL=https://api.your-domain.com
